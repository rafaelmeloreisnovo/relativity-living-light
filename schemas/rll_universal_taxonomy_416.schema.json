{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rll_universal_taxonomy_416.schema.json",
  "title": "RLL Universal Taxonomy 416 Registry",
  "description": "Structural contract for the user-supplied 30+386 taxonomy. Structural validity does not validate novelty, truth, implementation, patentability, or scientific claims; claim_allowed=false.",
  "type": "object",
  "required": [
    "registry_id",
    "source_provenance",
    "count_audit",
    "invariants",
    "completion_profiles",
    "clusters",
    "modules"
  ],
  "properties": {
    "registry_id": {
      "const": "RLL-UNIVERSAL-TAXONOMY-416-V1"
    },
    "source_provenance": {
      "type": "object",
      "required": [
        "baseline_macrothemes",
        "module_count",
        "claimed_total",
        "claim_allowed"
      ],
      "properties": {
        "baseline_macrothemes": {"const": 30},
        "module_count": {"const": 386},
        "claimed_total": {"const": 416},
        "claim_allowed": {"const": false}
      }
    },
    "modules": {
      "type": "array",
      "minItems": 386,
      "maxItems": 386,
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "source_index",
          "cluster_id",
          "cluster_position",
          "label",
          "epistemic_state",
          "completion_profile",
          "completion_state",
          "claim_allowed"
        ],
        "properties": {
          "module_id": {"type": "string", "pattern": "^UTM-[0-9]{3}$"},
          "source_index": {"type": "integer", "minimum": 1, "maximum": 386},
          "cluster_id": {"enum": ["I", "II", "III", "IV", "V", "VI", "VII", "VIII"]},
          "cluster_position": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "minLength": 1},
          "claim_allowed": {"const": false},
          "completion_state": {"type": "string", "pattern": "^TOKEN_VAZIO"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
